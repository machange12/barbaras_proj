# Copy to `.env` and adjust for your environment.

APP_NAME="The Reading Salon API"
ENVIRONMENT=local

# Postgres in production: postgresql+psycopg://user:pass@host:5432/db
# Local dev default uses SQLite for zero-setup.
DATABASE_URL=sqlite:///./local.db

JWT_SECRET_KEY=change-me-in-production-please-use-a-32-or-more-character-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=the-reading-salon
JWT_AUDIENCE=the-reading-salon-clients
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for the frontend.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
