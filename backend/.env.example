# Copy to `.env` for local dev (Docker compose will read this).

APP_NAME="The Reading Salon API"
ENVIRONMENT=local
TESTING=

# Postgres (Docker service name is `db`).
DATABASE_URL=postgresql+psycopg://salon:salon@localhost:5432/salon

# Production / Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET_KEY=local-development-secret-please-replace-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ISSUER=the-reading-salon
JWT_AUDIENCE=the-reading-salon-clients
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MailHog (dev SMTP).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=salon@example.test
SMTP_FROM_NAME="The Reading Salon"

# Optional initial curator (used by `python -m app.cli bootstrap` if you opt in later).
INITIAL_CURATOR_EMAIL=
INITIAL_CURATOR_PASSWORD=

BCRYPT_ROUNDS=12
