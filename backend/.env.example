APP_NAME="The Reading Salon API"
ENVIRONMENT="local"
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
DATABASE_URL="postgresql+psycopg://salon:salon@localhost:5432/reading_salon"
JWT_SECRET_KEY="change-this-before-running-any-shared-environment"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
